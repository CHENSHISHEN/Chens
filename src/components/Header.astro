---
import { navigation } from "@/data/space";
import SpaceIcon from "./SpaceIcon.astro";
const path = Astro.url.pathname;
---

<a class="skip-link" href="#main-content">跳转到正文</a>
<header class="space-header">
  <div class="space-header-inner">
    <a class="space-brand" href="/" aria-label="chen space 首页"
      ><span class="brand-mark">c<span>_</span></span><span
        >chen<span class="brand-slash"> / </span>space<span class="brand-dot"
          >.</span
        ></span
      ></a
    >
    <nav class="desktop-nav" aria-label="主导航">
      {
        navigation.map(item => (
          <a
            href={item.href}
            class:list={[{ selected: path.startsWith(item.href) }]}
            aria-current={path.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
            <span class="nav-active-dot" />
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <button class="space-search" data-search-trigger aria-label="搜索全站"
        ><SpaceIcon name="search" size={16} /><span>搜索</span><kbd>⌘ K</kbd
        ></button
      >
      <span class="header-divider"></span>
      <button
        id="theme-btn"
        class="icon-button"
        title="切换明暗主题"
        aria-label="切换明暗主题"><SpaceIcon name="sun" size={18} /></button
      >
      <button
        class="icon-button mobile-menu-toggle"
        aria-label="展开导航"
        aria-expanded="false"
        aria-controls="space-mobile-nav"><SpaceIcon name="menu" /></button
      >
    </div>
  </div>
  <nav
    id="space-mobile-nav"
    class="space-mobile-nav"
    aria-label="手机导航"
    hidden
  >
    <a href="/">首页</a>{
      navigation.map(item => <a href={item.href}>{item.label}</a>)
    }
  </nav>
</header>
<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector<HTMLButtonElement>(
      ".mobile-menu-toggle"
    );
    const menu = document.getElementById("space-mobile-nav");
    const close = () => {
      if (menu && toggle) {
        menu.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "展开导航");
      }
    };
    toggle?.addEventListener("click", () => {
      if (!menu) return;
      menu.hidden = !menu.hidden;
      toggle.setAttribute("aria-expanded", String(!menu.hidden));
      toggle.setAttribute("aria-label", menu.hidden ? "展开导航" : "收起导航");
    });
    menu?.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        close();
        toggle?.focus();
      }
    });
    toggle?.addEventListener("keydown", event => {
      if (event.key === "Escape") close();
    });
  });
</script>
