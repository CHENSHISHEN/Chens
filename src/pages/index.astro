---
import { getCollection } from "astro:content";
import SpaceLayout from "@/layouts/SpaceLayout.astro";
import SpacePostCard from "@/components/SpacePostCard.astro";
import SpaceIcon from "@/components/SpaceIcon.astro";
import FamilyShowcase from "@/components/FamilyShowcase.astro";
import { navigation } from "@/data/space";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);
const featured = posts.filter(post => post.data.featured).slice(0, 2);
const recent = posts.filter(post => !post.data.featured).slice(0, 4);
const descriptions = [
  "想法、实践与技术记录",
  "把想法变成可用的东西",
  "不断连接的知识地图",
  "那些顺手的效率工具",
];
---

<SpaceLayout>
  <div class="page-topline">
    <span>个人空间 <span class="topline-slash">/</span> 首页</span><span
      class="mono">HELLO, WORLD <span class="tiny-star">✳</span></span>
  </div>
  <section class="space-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="terminal-prompt">
        <span class="status-dot"></span><span class="mono"
          >~/chen/space <span class="prompt-dollar">$</span></span>
      </div>
      <h1 id="hero-title">
        把好奇心，<br /><span
          >写成自己的世界<span class="hero-period">.</span></span>
      </h1>
      <p class="hero-description">
        你好，我是 chen。这里收藏技术探索、项目实践，<br
          class="desktop-break"
        />也记录每一次从「知道」到「做到」的小小进步。
      </p>
      <div class="hero-buttons">
        <a class="button-primary" href="/posts/"
          >开始阅读<SpaceIcon name="arrow" size={16} /></a
        ><a class="button-secondary" href="/projects/"
          ><SpaceIcon name="code" size={16} />看看我的项目</a>
      </div>
      <div class="hero-footnote">
        <span></span>数据工程<span class="footnote-dot">/</span>AI 实践<span
          class="footnote-dot">/</span
        >终身学习
      </div>
    </div>
    <div class="hero-terminal" aria-label="个人空间内容结构">
      <div class="terminal-top">
        <div class="terminal-dots"><i></i><i></i><i></i></div><span class="mono"
          >workspace.md</span
        ><SpaceIcon name="code" size={13} />
      </div>
      <div class="terminal-body mono">
        <p class="terminal-comment">// a little space, a growing mind.</p><p>
          <span class="code-purple">const</span>
          <span class="code-white">chen</span> = {"{"}
        </p><p class="code-indent">
          focus: <span class="code-amber">"Data &amp; AI"</span>,
        </p><p class="code-indent">
          mode: <span class="code-green">"always learning"</span>,
        </p><p class="code-indent">
          ideas: <span class="code-white">Infinity</span>
        </p><p>{"}"};</p><div class="terminal-line"></div><p
          class="terminal-command"
        >
          <span>❯</span> build something meaningful<span class="terminal-caret"
          ></span>
        </p>
      </div>
      <div class="terminal-bottom mono">
        <span class="status-dot"></span>curiosity is running<span>UTF-8</span>
      </div>
    </div><span class="hero-orbit" aria-hidden="true"></span>
  </section>
  <section class="module-grid" aria-label="空间模块">
    {
      navigation.slice(0, 4).map((item, index) => (
        <a
          href={item.href}
          class:list={[
            "module-tile",
            ["purple", "green", "blue", "amber"][index],
          ]}
        >
          <>
            <span class="module-icon">
              <SpaceIcon name={item.icon} size={19} />
            </span>
            <span>
              <>
                <strong>{item.label}</strong>
                <small>{descriptions[index]}</small>
              </>
            </span>
            <span class="module-arrow">↗</span>
          </>
        </a>
      ))
    }
  </section>
  <section class="featured-section">
    <div class="section-heading">
      <h2>
        <SpaceIcon name="star" size={16} /><span>精选内容</span><small
          >FEATURED</small>
      </h2><span class="heading-line"></span><span class="section-note"
        >值得停下来读一读</span>
    </div><div class="featured-grid">
      {featured.map(post => <SpacePostCard post={post} featured />)}
    </div>
  </section>
  <FamilyShowcase />
  <div class="home-lower">
    <section>
      <div class="section-heading">
        <h2>
          <span class="heading-square"></span><span>最近更新</span><small
            >LATEST</small>
        </h2><span class="heading-line"></span><a href="/posts/"
          >全部文章 <span>↗</span></a>
      </div><div class="recent-posts">
        {recent.map(post => <SpacePostCard post={post} />)}
      </div>
    </section>
    <aside class="now-panel">
      <div class="now-heading">
        <span class="status-dot"></span>此刻在探索<span class="mono"
          >/ NOW</span>
      </div><h3>让想法落地，<br />也给思考留白。</h3><p>
        这里会慢慢长出技术笔记、独立项目，以及值得反复阅读的内容。
      </p><a href="/about/">认识一下我<SpaceIcon name="arrow" size={15} /></a
      ><div class="now-divider"></div><div class="seed-label mono">
        SEED → NOTE → IDEA
      </div><div class="growth-art" aria-hidden="true">
        <span>✳</span><i></i><b>+</b><small>+</small>
      </div><div class="preview-notice">首版预览 · 文章与项目为展示示例</div>
    </aside>
  </div>
</SpaceLayout>
