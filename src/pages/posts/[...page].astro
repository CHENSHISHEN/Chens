---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import SpaceLayout from "@/layouts/SpaceLayout.astro";
import SpacePostCard from "@/components/SpacePostCard.astro";
import { categories } from "@/data/space";
export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
  );
  return paginate(posts, { pageSize: 100 });
}) satisfies GetStaticPaths;
const { page } = Astro.props;
---

<SpaceLayout
  title="博客"
  description="数据工程、AI 与自动化、开发工具，以及思考与记录。"
>
  <div class="page-topline">
    <a href="/">个人空间</a><span class="mono">THE BLOG</span>
  </div>
  <section class="inner-hero">
    <div class="inner-eyebrow">THINK. BUILD. WRITE.</div><h1>
      边做，边记录。
    </h1><p>把实践中遇到的问题、学到的知识，写成下一次出发时的路标。</p>
  </section>
  <div class="demo-banner" data-pagefind-ignore>
    当前为主题预览，以下为中文示例文章，用于展示分类与阅读体验。
  </div>
  <div class="filter-bar" aria-label="筛选文章主题">
    <button class="filter-button" data-filter="all" aria-pressed="true"
      >全部文章</button
    >{
      categories.map(category => (
        <button
          class="filter-button"
          data-filter={category.tag}
          aria-pressed="false"
        >
          {category.name}
        </button>
      ))
    }<span class="filter-count" aria-live="polite">共 {page.total} 篇文章</span>
  </div>
  <div class="posts-list">
    {page.data.map(post => <SpacePostCard {post} />)}
  </div>
  <p class="empty-filter" hidden>这个主题还没有文章，先看看其他分类吧。</p>
</SpaceLayout>
<script>
  document.addEventListener("astro:page-load", () => {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>(
      ".posts-list [data-topic]"
    );
    if (!buttons.length) return;
    const filter = (topic: string) => {
      let count = 0;
      cards.forEach(card => {
        card.hidden = topic !== "all" && card.dataset.topic !== topic;
        if (!card.hidden) count++;
      });
      buttons.forEach(button =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filter === topic)
        )
      );
      const label = document.querySelector(".filter-count");
      if (label) label.textContent = `共 ${count} 篇文章`;
      const empty = document.querySelector<HTMLElement>(".empty-filter");
      if (empty) empty.hidden = count > 0;
      document
        .querySelectorAll<HTMLAnchorElement>(".topic-links a")
        .forEach(link => {
          const active = new URL(link.href).searchParams.get("topic") === topic;
          if (active) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
    };
    const readURL = () => {
      const topic = new URLSearchParams(location.search).get("topic") ?? "all";
      filter(
        Array.from(buttons).some(button => button.dataset.filter === topic)
          ? topic
          : "all"
      );
    };
    buttons.forEach(button =>
      button.addEventListener("click", () => {
        const topic = button.dataset.filter!;
        const url = new URL(location.href);
        if (topic === "all") url.searchParams.delete("topic");
        else url.searchParams.set("topic", topic);
        history.replaceState(null, "", url);
        filter(topic);
      })
    );
    readURL();
  });
</script>
