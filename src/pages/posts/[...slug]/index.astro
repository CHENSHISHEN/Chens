---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SpaceLayout from "@/layouts/SpaceLayout.astro";
import { getPath } from "@/utils/getPath";
export async function getStaticPaths() {
  return (await getCollection("blog", ({ data }) => !data.draft)).map(post => ({
    params: { slug: getPath(post.id, post.filePath, false) },
    props: { post },
  }));
}
interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<SpaceLayout title={post.data.title} description={post.data.description}>
  <a class="back-link" href="/posts/">← 返回博客</a>
  <article>
    <header class="inner-hero">
      <div class="inner-eyebrow">
        NOTES / {
          post.data.pubDatetime.toLocaleDateString("zh-CN", {
            timeZone: "Asia/Shanghai",
          })
        }
      </div><h1 data-pagefind-meta="title">{post.data.title}</h1><p>
        {post.data.description}
      </p>
    </header>{
      post.data.demo && (
        <div class="demo-banner" data-pagefind-ignore>
          内容示例：这篇文章用于预览主题与阅读体验，不代表 chen
          的真实项目经历或已发布成果。
        </div>
      )
    }<div class="detail-body"><Content /></div>
  </article>
</SpaceLayout>
